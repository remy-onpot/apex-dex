// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MENTOR
  STUDENT
}

enum PostType {
  TRADE_SETUP
  ANNOUNCEMENT
  GENERAL
  LESSON
}

enum TradeStatus {
  ACTIVE
  UPDATED
  CLOSED
  INVALIDATED
}

enum ReviewStatus {
  PENDING
  GRADED
}

enum NotificationType {
  NEW_TRADE
  TRADE_UPDATE
  REVIEW_COMPLETED
  SYSTEM
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  role                UserRole  @default(STUDENT)
  subscriptionEndDate DateTime?
  isPremium           Boolean   @default(false)
  createdAt           DateTime  @default(now()) @map(name: "created_at")
  updatedAt           DateTime  @default(now()) @map(name: "updated_at")

  accounts         Account[]
  sessions         Session[]
  posts            Post[]
  chartSubmissions ChartSubmission[]
  payments         Payment[]
  notifications    Notification[]
  postReadReceipts PostReadReceipt[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   Json?
  imageUrls Json?
  published Boolean  @default(false)
  type      PostType @default(GENERAL)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @map(name: "updated_at")
  authorId  String

  author        User              @relation(fields: [authorId], references: [id])
  tradeMetadata TradeMetadata?
  readReceipts  PostReadReceipt[]

  @@map("posts")
}

model PostReadReceipt {
  id     String   @id @default(cuid())
  userId String
  postId String
  readAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("post_read_receipts")
}

model TradeMetadata {
  id         String      @id @default(cuid())
  postId     String      @unique
  asset      String
  direction  String
  entryPrice String
  stopLoss   String
  takeProfit String
  status     TradeStatus @default(ACTIVE)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ChartSubmission {
  id        String       @id @default(cuid())
  studentId String
  imageUrl  String
  thesis    String       @db.Text
  feedback  String?      @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  student User @relation(fields: [studentId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  userId    String
  amount    Int
  currency  String        @default("GHS")
  reference String        @unique
  provider  String
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  targetUrl String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

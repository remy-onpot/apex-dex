# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Generate a local secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL
# Use a pooler URL for the app if required by your deployment runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&sslmode=require
# Direct PostgreSQL URL for Prisma migrations (often port 5432 on Supabase).
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# OAuth providers enabled in lib/auth.ts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase Storage (needed for image uploads)
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=posts
